 "unit_type_fit_rules": {
  "T_HEAL_UP": {"allow": ["healer"]},
  "T_ATK_UP": {"deny": ["healer"]},
  "T_ATKDEF_HYBRID": {"deny": ["healer"]},
  "T_DEF_UP": {"allow": "all", "note": "heavy는 합계 <= 20, archer/mage는 실가치 0.3~0.4배 -> 점수 환산 시 type_multiplier 적용(과금 불이익 방지로 지급 수치 하향 금지, 대신 다른 스킬로 보충)"},
  "T_MOVE_UP": {"allow": ["sword", "spear", "archer", "mage", "healer"], "deny": ["cavalry", "flyer"], "note": "move5 유닛은 +1도 과도(맵 소형) - 가정"},
  "T_RANGE_UP": {"allow": ["archer", "mage"]},
  "T_VS_TYPE_ATK": {"note": "상성이 이미 유리한 조합(spear->cavalry 1.25)에 중복 부여 금지"},
  "T_CHARGE": {"allow": ["cavalry", "flyer", "sword", "spear"], "deny": ["archer", "mage", "healer"]},
  "T_REGEN": {"allow": "all"},
  "T_AURA_*": {"allow": "지휘관 역할 영웅만(엔진이 kind=commander만 오라 적용)"}
 },

