{
 "_note": "스킬 시스템 1단계 설계(데이터 전용, 엔진/DB/시드 미연결). 모든 수치는 시작값이며 시뮬레이션·사람 플레이로 보정 필요. engine_status: supported=현재 엔진이 해석(passive atk_pct/def_pct/heal, 오라 atk/def/radius) / needs_engine_small=damageInfo·endTurn 등 국소 수정 / needs_engine_large=시스템 신규 필요. 기존 skills.json/auras.json/heroes.json은 수정하지 않음.",
 "version": 1,
 "engine_facts": {
  "_source": "app/Game/Engine.php, RuleSet.php, ArmyBuilder.php, GameData.php, config/game.php 직접 확인",
  "passive_keys_read_by_engine": ["atk_pct", "def_pct", "heal"],
  "passive_scope": "영웅 유닛 본인에게만 적용(부대 유닛 passive=null). 영웅당 skill_id 1개 -> 현재 영웅당 패시브 1개만 적재 가능",
  "passive_requires_option": "rules.passive_skills=true (현재 config true)",
  "atk_formula": "dmg = max(minDmg, round(atk x clamp(상성 x (1 + (오라atk + 패시브atk + 후공보정)/100)) - def x (1 + (오라def + 패시브def + 지형def)/100)))",
  "clamp": "config rules.clamp=[0.6,1.5]; 상성 유리(1.25)에서 가산 공격보정 합이 +20%를 넘으면 초과분은 버려짐",
  "min_damage_pct": "0.15 -> 최소 피해 = max(1, round(공격력 x 0.15))",
  "heal": "치유사(unit_type.heal>0) 본인만 발동, 턴 종료 시 인접(거리1) 아군. 량=max(heal+패시브heal, 대상 max_hp x 0.15), heal_cap=30(진영 턴 합)",
  "aura": "지휘관(kind=commander) 본인 오라만 유효, 맨해튼 반경 내 같은 진영 유닛(본인 포함)에 atk/def 가산. 값은 정수(DB int)",
  "passive_applies_on_counter": "damageInfo를 반격에도 사용 -> 패시브 atk/def는 반격에도 적용",
  "not_supported": ["체력/지형/상대병종 조건부", "이동력/사거리 보정", "반격 전용 보정", "턴·이동 여부 조건", "자가 재생", "상태이상/사기", "액티브 스킬(이벤트 skill/aura 미발생)"],
  "db_note": "skills 테이블은 code/type/params/description만 적재 -> template/tags/evidence 등 신규 메타는 현 시드로 적재 불가(요청서 R0 참조)"
 },

 "point_system": {
  "_note": "스킬 가치 점수(point). 모두 가정 시작값. 1pt 기준 = 'def_pct 1%(검병/창병 기준)'.",
  "unit_points": {
