 "skill_record_schema": {
  "fields": {
   "code": "string, snake_case unique",
   "name": "string(ko)",
   "template": "template id",
   "params": "object, template.param_schema 범위 내",
   "tags": "string[] (tag_list), 최대 3",
   "evidence_level": "enum: confirmed | accepted | disputed | legendary | invented | unreviewed (출시 풀 영웅 고유 스킬은 confirmed/accepted만)",
   "source": "string, 근거 출처(송서사 작성) - unreviewed 시 null",
   "is_invented": "bool, 게임 창작 명칭/효과 여부",
   "rarity_min": "enum C|B|A|S",
   "fx_key": "string, 연출 키(없으면 null)",
   "flavor": "string(ko), 한 줄 설명",
   "enabled": "bool(선택 확장 필드, 기본 true. 예비/액티브 보류는 false) - 결정된 스키마 외 추가라 확인 필요"
  }
